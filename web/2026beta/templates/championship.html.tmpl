<td>
	<table class = 'championship' cellpadding="0" cellspacing="0" width="100%">
	<tbody>
	[% n = [ start .. end ] %]
	[% FOR x IN n %]
		[% row = games.$x %]
		<tr><td class="[% class %]">&nbsp;
		<div class = 'flash_effect'></div>
		[% elements = [ 0 .. 63  ] %]
		[% FOR element IN elements %]
		[% team = row.teams.$element %][% prevGame = row.prevGame.$element %]
		[% seed = seeds.$team %]
			<span id = '[% row.game %] [% team %] select' style = "display: none;" class = 'radio'>
				<input name="radio_[% row.game %]" id = 'radio_[% row.game %]_[% loop.count %]' value="[% team %]" type="radio" 
				       onClick='pickChampion("[% team %]")'
				       aria-label="Select [% seed %] seed [% team %] as champion">[% seed %] [% team %]
				<img src = '/jqmcbp/images/remove.gif' onClick='secondThoughts("[% team %]","[% row.game %]","[% prevGame %]")' 
				     alt="Remove [% team %]" title="Remove this selection" role="button" tabindex="0"><br>
			</span>
			<span id = '[% row.game %] [% team %] done' class = 'hidden normal' aria-live="polite">
				<span id = '[% row.game %] [% team %]'>[% seed %] [% team %]<br></span>
			</span>
		[% END %]
	[% END %]

<div id = 'pickCandy' class = 'hidden'>
		[% row = games.$start %]
		[% elements = [ 0 .. 63 ] %]
		[% FOR element IN elements %]
			[% team = row.teams.$element %][% prevGame = row.prevGame.$element %]
			[% seed = seeds.$team %]
			<span id = 'champion[% element %]' class = 'hidden picked'>
				<p></p>
				<p></p>
				<b>Champion: </b>[% seed %] [% team %] <img src = '/jqmcbp/images/remove.gif' onClick='secondThoughtsChamp("[% element %]")' />
			</span>
		[% END %]
	<br>
	And now for the most important part...<br>
	Pick your CANDY!<br>
	<label for="candy_input" class="sr-only">Enter your desired candy bar</label>
	<input type = text name = 'candy' id = 'candy_input' class = 'textinput' size = 30 maxlength = 60 
	       aria-label="Enter your desired candy bar prize" placeholder="e.g., Snickers, Kit Kat, Reese's"><br>
	<img src="/jqmcbp/bk_files/forward" align="middle" alt="">
	<input name="ENTER_PICKS" src="/jqmcbp/bk_files/go_ben_go" value="true" align="center" type="image" alt="Submit bracket">
	<img src="/jqmcbp/bk_files/back" align="middle" alt="">
</div>
		</td></tr>
	</tbody></table>
</td>

