<script type="text/javascript">
// Inline validation functions
function showError(fieldName, message) {
	const errorId = fieldName + '_error';
	let errorElem = document.getElementById(errorId);
	if (!errorElem) {
		errorElem = document.createElement('div');
		errorElem.id = errorId;
		errorElem.className = 'field_error';
		errorElem.setAttribute('role', 'alert');
		const field = document.getElementsByName(fieldName)[0];
		field.parentNode.appendChild(errorElem);
		field.classList.add('error');
	}
	errorElem.textContent = message;
	errorElem.style.display = 'block';
}

function clearError(fieldName) {
	const errorId = fieldName + '_error';
	const errorElem = document.getElementById(errorId);
	if (errorElem) {
		errorElem.style.display = 'none';
	}
	const field = document.getElementsByName(fieldName)[0];
	if (field) {
		field.classList.remove('error');
	}
}

function validateName(showErrors) {
	const nameField = document.getElementsByName('name')[0];
	const name = nameField.value.trim();
	
	if (name === '') {
		if (showErrors) showError('name', 'Please state your name');
		return false;
	}
	clearError('name');
	return true;
}

function validateEmail(showErrors) {
	const emailField = document.getElementsByName('email')[0];
	const email = emailField.value.trim();
	
	if (email === '') {
		if (showErrors) showError('email', 'Honest, your email address is safe with me. Please give me one');
		return false;
	} else if (!isEmailAddr(emailField)) {
		if (showErrors) showError('email', "'" + email + "' does not look like a valid email address");
		return false;
	}
	clearError('email');
	return true;
}

function validateLocale(showErrors) {
	const localeField = document.getElementsByName('locale')[0];
	
	if (localeField.selectedIndex === 0) {
		if (showErrors) showError('locale', 'Where are you from? Note that "Places Unknown" is an option!');
		return false;
	}
	clearError('locale');
	return true;
}

function isEmailAddr(elem) {
	const str = elem.value.toLowerCase();
	if (str.indexOf("@") === -1) {
		return false;
	} else {
		const addr = str.substring(0, str.indexOf("@"));
		const domain = str.substring(str.indexOf("@") + 1, str.length);
		if (domain.indexOf(".") === -1 || addr.length === 0) {
			return false;
		}
	}
	return true;
}

function validateForm(form) {
	let isValid = true;
	
	if (!validateName(true)) isValid = false;
	if (!validateEmail(true)) isValid = false;
	if (!validateLocale(true)) isValid = false;
	
	if (!isValid) {
		// Scroll to first error
		const firstError = document.querySelector('.field_error[style*="display: block"]');
		if (firstError) {
			firstError.scrollIntoView({ behavior: 'smooth', block: 'center' });
		}
	}
	
	return isValid;
}

function get_count() {
	// chrome keeps a JS cache, so we have to fudge a bogus query string
	// to get around that
	const random = Math.floor((Math.random() * 99999) + 1);
	$.getJSON(
		'entry_count.json?foo=bar' + random,
		function(data) {
			$('.entry_count').replaceWith('<span class = "entry_count">' + data.entry_count + '</span>');
			$('.entry_count').fadeIn('slow');
			setTimeout(function() { get_count(); }, 15000);
		}
	);
}

$(document).ready(function() {
	// Auto-focus first field
	const nameField = document.getElementsByName('name')[0];
	if (nameField) {
		nameField.focus();
	}
	
	// Add real-time validation on blur
	$('input[name="name"]').on('blur', function() { validateName(false); });
	$('input[name="email"]').on('blur', function() { validateEmail(false); });
	$('select[name="locale"]').on('change', function() { validateLocale(false); });
	
	// Clear errors on focus
	$('input[name="name"]').on('focus', function() { clearError('name'); });
	$('input[name="email"]').on('focus', function() { clearError('email'); });
	$('select[name="locale"]').on('focus', function() { clearError('locale'); });
	
	// Start entry counter
	setTimeout(function() {
		get_count();
	}, 2000);
});
</script>

